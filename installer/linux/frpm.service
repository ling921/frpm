[Unit]
Description=FRPM native tunnel runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory="__FRPM_INSTALL_DIR__"
ExecStart="__FRPM_INSTALL_DIR__/Frpm.Desktop" --headless
Restart=on-failure
RestartSec=5
TimeoutStopSec=35

[Install]
WantedBy=default.target
