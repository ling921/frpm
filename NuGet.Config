<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="MudBlazor" />
      <package pattern="Avalonia*" />
      <package pattern="MicroCom.*" />
      <package pattern="HarfBuzzSharp*" />
      <package pattern="SkiaSharp*" />
      <package pattern="Tmds.*" />
      <package pattern="Mapster*" />
      <package pattern="Ling.*" />
      <package pattern="Humanizer.*" />
      <package pattern="Mono.TextTemplating" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="xunit*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
