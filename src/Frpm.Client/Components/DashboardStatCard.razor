<MudItem xs="12" sm="6" md="4" lg="3">
    <MudPaper Class="pa-5" Elevation="0" Outlined>
        <MudStack Row AlignItems="AlignItems.Center">
            <MudAvatar Color="@Color" Variant="Variant.Filled"><MudIcon Icon="@Icon" /></MudAvatar>
            <div><MudText Typo="Typo.caption">@Title</MudText><MudText Typo="Typo.h4">@Value</MudText></div>
        </MudStack>
    </MudPaper>
</MudItem>
