<MudStack Row Spacing="1" AlignItems="AlignItems.Center">
    @if (Loading)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Primary" />
    }
    else
    {
        @if (IsRunning)
        {
            <MudTooltip Text="@(_stopReason ?? "停止本地隧道进程")">
                <MudIconButton Icon="@Icons.Material.Filled.Stop"
                               Color="Color.Warning"
                               Size="Size.Small"
                               Disabled="@(Disabled || !CanStopNow)"
                               OnClick="ToggleAsync" />
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="@(_startReason ?? "启动本地隧道进程")">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                               Color="Color.Success"
                               Size="Size.Small"
                               Disabled="@(Disabled || !CanStartNow)"
                               OnClick="ToggleAsync" />
            </MudTooltip>
        }
        @if (IsKickVisible)
        {
            <MudTooltip Text="@(_kickReason ?? "强制下线远端残留会话并重置")">
                <MudIconButton Icon="@Icons.Material.Filled.PowerSettingsNew"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Disabled="@(Disabled || !CanKickNow)"
                               OnClick="() => Kick.InvokeAsync(Tunnel)" />
            </MudTooltip>
        }
        <MudTooltip Text="@(_editReason ?? "编辑")">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Disabled="@(Disabled || !CanEditNow)"
                           OnClick="() => Edit.InvokeAsync(Tunnel)" />
        </MudTooltip>
        <MudTooltip Text="查看日志">
            <MudIconButton Icon="@Icons.Material.Filled.Article"
                           Size="Size.Small"
                           Disabled="Disabled"
                           OnClick="() => OpenLog.InvokeAsync(Tunnel)" />
        </MudTooltip>
        <MudTooltip Text="@(_deleteReason ?? "删除")">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           Disabled="@(Disabled || !CanDeleteNow)"
                           OnClick="() => Delete.InvokeAsync(Tunnel)" />
        </MudTooltip>
    }
</MudStack>
