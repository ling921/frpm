<MudStack Row Spacing="1">
    <MudIconButton Icon="@(IsRunning ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)"
                   Color="@(IsRunning ? Color.Warning : Color.Success)"
                   Size="Size.Small"
                   OnClick="ToggleAsync" />
    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Edit.InvokeAsync(Tunnel)" />
    <MudIconButton Icon="@Icons.Material.Filled.Article" Size="Size.Small" OnClick="() => OpenLog.InvokeAsync(Tunnel)" />
    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => Delete.InvokeAsync(Tunnel)" />
</MudStack>
