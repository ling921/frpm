<MudDialog>
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Terminal" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6">@Run.TunnelName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@RunDescription</MudText>
            </div>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense Class="mb-3">@_error</MudAlert>
        }
        <pre @ref="_outputElement" class="realtime-log-output">@LogText</pre>
    </DialogContent>
    <DialogActions>
        <MudChip T="string" Size="Size.Small" Color="@(IsLive ? Color.Success : Color.Default)">
            @(IsLive ? "实时刷新" : "运行已结束")
        </MudChip>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshNowAsync" Disabled="_refreshing">刷新</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Dialog.Close())">关闭</MudButton>
    </DialogActions>
</MudDialog>
