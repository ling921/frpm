@page "/tunnels"

<PageTitle>隧道 - FRPM</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Class="mb-5">
    <div>
        <MudText Typo="Typo.h4">隧道</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">远端状态、期望状态和本地进程状态相互独立。</MudText>
    </div>
    <MudSpacer />
    @if (_refreshing)
    {
        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
            <MudProgressCircular Indeterminate Size="Size.Small" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">正在刷新…</MudText>
        </MudStack>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">创建隧道</MudButton>
</MudStack>

@if (_editorOpen)
{
    <MudPaper Class="pa-5 mb-5" Outlined Elevation="0">
        <MudText Typo="Typo.h6" GutterBottom>@(_request.TunnelId is null ? "创建隧道" : "编辑隧道")</MudText>
        <MudGrid>
            <MudItem xs="12" md="4"><MudSelect T="Guid" Label="供应商账号" Value="_request.ProviderAccountId" ValueChanged="OnProviderAccountChangedAsync" Variant="Variant.Outlined" Disabled="@(_request.TunnelId is not null)">@foreach (var account in _accounts) { <MudSelectItem Value="account.Id">@account.DisplayName (@BuiltInProviderCatalog.Get(account.ProviderType).DisplayName)</MudSelectItem> }</MudSelect></MudItem>
            <MudItem xs="12" md="4"><MudTextField Label="隧道名称" @bind-Value="_request.Name" Variant="Variant.Outlined" Required /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" Label="类型" Value="_request.Type" ValueChanged="OnTunnelTypeChanged" Variant="Variant.Outlined">
                    @foreach (var type in AvailableTunnelTypes)
                    {
                        <MudSelectItem Value="type">@type.ToUpperInvariant()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                    @(_request.TunnelId is null ? "服务器节点" : "服务器节点（编辑时不可修改）")
                </MudText>
                @if (SelectedNode is { } node)
                {
                    <MudPaper Outlined="true" Class="pa-2 d-flex align-center justify-space-between flex-wrap gap-2"
                              Style="border-color: var(--mud-palette-primary); min-height: 56px;">
                        <MudStack Spacing="0">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small"
                                         Color="@(node.IsOnline ? Color.Success : Color.Error)" Style="font-size: 8px;" />
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@node.Name</MudText>
                                @if (node.LoadPercent is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@(node.LoadPercent < 50 ? Color.Success : node.LoadPercent < 80 ? Color.Warning : Color.Error)"
                                             Style="height: 18px; font-size: 10px;">
                                        @node.LoadPercent% 负载
                                    </MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(node.Region ?? "未知地区") @(string.IsNullOrWhiteSpace(node.Bandwidth) ? "" : $"· {node.Bandwidth}")
                            </MudText>
                        </MudStack>
                        @if (_request.TunnelId is null)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="OpenNodeSelectorAsync"
                                       Disabled="@_loadingNodes">
                                更换
                            </MudButton>
                        }
                    </MudPaper>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Dns" OnClick="OpenNodeSelectorAsync"
                               Disabled="@(_loadingNodes || _request.TunnelId is not null)"
                               Style="height: 56px; border-style: dashed;">
                        @(_loadingNodes ? "正在加载节点..." : "点击挑选服务器节点")
                    </MudButton>
                }
                @if (_loadingNodes) { <MudProgressLinear Indeterminate Class="mt-1" /> }
                else if (RequiresNode && string.IsNullOrWhiteSpace(_request.NodeId))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1 d-block">必须选择一个节点</MudText>
                }
            </MudItem>
            @if (RequiresLocalEndpoint)
            {
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string" Label="本地地址" @bind-Value="_request.LocalAddress" SearchFunc="SearchLocalAddressesAsync" Variant="Variant.Outlined" Strict="false" CoerceValue MinCharacters="0" Clearable />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudAutocomplete T="int?" Label="本地端口" @bind-Value="_request.LocalPort" SearchFunc="SearchLocalPortsAsync" ToStringFunc="FormatPort" Variant="Variant.Outlined" Strict="false" CoerceValue MinCharacters="0" MaxItems="12" Style="flex:1;min-width:0" />
                        <MudTooltip Text="由 FRPM 所在机器测试本地服务">
                            <MudIconButton Icon="@Icons.Material.Filled.NetworkCheck" Color="Color.Primary" OnClick="TestLocalEndpointAsync" Disabled="@(_busy || _testingEndpoint)" />
                        </MudTooltip>
                    </MudStack>
                </MudItem>
            }
            else
            {
                <MudItem xs="12" md="8"><MudAlert Severity="Severity.Info" Dense>WOL 隧道会由 frpc 在本地网络发送唤醒包，无需填写本地地址和端口。</MudAlert></MudItem>
            }
            @if (UsesDomains)
            {
                <MudItem xs="12" md="4">
                    <MudTextField Label="绑定域名" @bind-Value="_request.CustomDomain" Variant="Variant.Outlined" Lines="2" HelperText="@DomainHelperText" />
                </MudItem>
            }
            else if (UsesRemotePort)
            {
                <MudItem xs="12" md="4"><MudNumericField T="int?" Label="远程端口（0 表示自动）" @bind-Value="_request.RemotePort" Variant="Variant.Outlined" Min="0" Max="65535" /></MudItem>
            }
            <MudItem xs="12" md="8"><MudTextField Label="备注" @bind-Value="_request.Remark" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        <MudStack Row Justify="Justify.FlexEnd" Class="mt-4"><MudButton OnClick="CloseEditor">取消</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">保存</MudButton></MudStack>
    </MudPaper>
}

<MudTextField @bind-Value="_search" Placeholder="搜索名称、账号、地址或状态" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Class="mb-4" Immediate />

@if (_selectedTunnels.Count > 0)
{
    <MudPaper Class="pa-3 mb-4 d-flex align-center flex-wrap gap-2" Elevation="2">
        <MudText Typo="Typo.subtitle2" Class="mr-2">已选择 <b>@_selectedTunnels.Count</b> 个隧道：</MudText>
        <MudTooltip Text="@BatchStartTooltip">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="BatchStartAsync" Disabled="@(_batchBusy || !CanBatchStart)">批量启动@(_batchStartCount > 0 ? $" ({_batchStartCount})" : "")</MudButton>
        </MudTooltip>
        <MudTooltip Text="@BatchStopTooltip">
            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Stop" OnClick="BatchStopAsync" Disabled="@(_batchBusy || !CanBatchStop)">批量停止@(_batchStopCount > 0 ? $" ({_batchStopCount})" : "")</MudButton>
        </MudTooltip>
        @if (IsBatchKickVisible)
        {
            <MudTooltip Text="@BatchKickTooltip">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PowerSettingsNew" OnClick="BatchKickAsync" Disabled="@(_batchBusy || !CanBatchKick)">批量强制下线@(_batchKickCount > 0 ? $" ({_batchKickCount})" : "")</MudButton>
            </MudTooltip>
        }
        <MudTooltip Text="@BatchDeleteTooltip">
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="BatchDeleteAsync" Disabled="@(_batchBusy || !CanBatchDelete)">批量删除</MudButton>
        </MudTooltip>
        <MudSpacer />
        @if (_batchBusy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
        }
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearSelection" Disabled="_batchBusy">取消选择</MudButton>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate />
}
else if (Filtered.Count == 0)
{
    <MudAlert Severity="Severity.Info">没有匹配的隧道。可先同步供应商账号或创建隧道。</MudAlert>
}
else
{
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTable T="TunnelModel" Items="Filtered" MultiSelection="true" @bind-SelectedItems="_selectedTunnels" Comparer="_tunnelComparer" SelectOnRowClick="false" Hover Dense Elevation="0" Outlined>
            <HeaderContent>
                <MudTh>隧道</MudTh>
                <MudTh>供应商</MudTh>
                <MudTh>映射</MudTh>
                <MudTh>远端</MudTh>
                <MudTh>本地进程</MudTh>
                <MudTh Style="text-align:right">操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="隧道">
                    <MudText Typo="Typo.body2">@context.Name</MudText>
                    <MudText Typo="Typo.caption">@context.Type.ToUpperInvariant() · @context.RemoteId</MudText>
                    @if (context.TodayTrafficInBytes is not null || context.TotalTrafficBytes is not null)
                    {
                        <br />
                        <MudTooltip Text="@($"入站: {FormatBytes(context.TodayTrafficInBytes)} · 出站: {FormatBytes(context.TodayTrafficOutBytes)} · 累计: {FormatBytes(context.TotalTrafficBytes)}")">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Style="height: 18px; font-size: 10px; margin-top: 2px;">
                                流量: @FormatBytes(context.TotalTrafficBytes ?? context.TodayTrafficInBytes)
                            </MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="供应商">@context.ProviderAccountName<br />
                    <MudText Typo="Typo.caption">
                        @NodeDisplay(context)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="映射">
                    <MudText Typo="Typo.body2">@context.LocalAddress:@context.LocalPort →</MudText>
                    @if (GetPublicAddresses(context) is { Count: > 0 } publicAddresses)
                    {
                        <MudStack Spacing="0">
                            @foreach (var publicAddress in publicAddresses)
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="0">
                                    @if (publicAddress.Url is not null)
                                    {
                                        <MudLink Href="@publicAddress.Url" Target="_blank" Typo="Typo.body2" Class="text-truncate" Style="max-width:190px">@publicAddress.Display</MudLink>
                                    }
                                    else { <MudText Typo="Typo.body2">@publicAddress.Display</MudText> }
                                    <MudTooltip Text="复制映射地址"><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyPublicAddressAsync(publicAddress.Display))" /></MudTooltip>
                                    @if (publicAddress.Url is not null)
                                    {
                                        <MudTooltip Text="在新窗口打开"><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="@publicAddress.Url" Target="_blank" /></MudTooltip>
                                    }
                                </MudStack>
                            }
                        </MudStack>
                    }
                    else { <MudText Typo="Typo.caption" Color="Color.Secondary">等待供应商返回映射地址</MudText> }
                </MudTd>
                <MudTd DataLabel="远端">
                    <MudChip T="string" Size="Size.Small" Color="@RemoteColor(context.RemoteState)">
                        @RemoteText(context.RemoteState)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="本地进程">
                    <MudTooltip Text="@RuntimeTooltip(context)">
                        <MudChip T="string" Size="Size.Small" Color="@RuntimeColor(context.RuntimeState)" Style="width:72px;justify-content:center">
                            @RuntimeText(context.RuntimeState)
                        </MudChip>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="操作" Style="text-align:right">
                    <TunnelActionButtons Tunnel="context" Loading="IsTunnelBusy(context.Id)" Disabled="_batchBusy" Start="StartAsync" Stop="StopAsync" Kick="KickAsync" Edit="EditAsync" OpenLog="OpenLogAsync" Delete="DeleteAsync" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudStack Spacing="2">
            @foreach (var tunnel in Filtered)
            {
                <MudCard Outlined>
                    <MudCardContent>
                        <MudStack Row AlignItems="AlignItems.Center">
                            <MudCheckBox T="bool" Value="@IsSelected(tunnel)" ValueChanged="@(selected => ToggleSelect(tunnel, selected))" Dense="true" Size="Size.Small" Color="Color.Primary" />
                            <div>
                                <MudText Typo="Typo.h6">@tunnel.Name</MudText>
                                <MudText Typo="Typo.caption">@tunnel.ProviderAccountName · @tunnel.Type.ToUpperInvariant()</MudText>
                                @if (tunnel.TodayTrafficInBytes is not null || tunnel.TotalTrafficBytes is not null)
                                {
                                    <br />
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Style="height: 18px; font-size: 10px;">
                                        流量: @FormatBytes(tunnel.TotalTrafficBytes ?? tunnel.TodayTrafficInBytes)
                                    </MudChip>
                                }
                            </div>
                            <MudSpacer />
                            <MudTooltip Text="@RuntimeTooltip(tunnel)">
                                <MudChip T="string" Size="Size.Small" Color="@RuntimeColor(tunnel.RuntimeState)" Style="width:72px;justify-content:center">
                                    @RuntimeText(tunnel.RuntimeState)
                                </MudChip>
                            </MudTooltip>
                        </MudStack>
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption">节点：@NodeDisplay(tunnel)</MudText>
                        @if (GetPublicAddresses(tunnel) is { Count: > 0 } publicAddresses)
                        {
                            <MudText Typo="Typo.body2">@tunnel.LocalAddress:@tunnel.LocalPort →</MudText>
                            <MudStack Spacing="0">
                                @foreach (var publicAddress in publicAddresses)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="0">
                                        @if (publicAddress.Url is not null)
                                        {
                                            <MudLink Href="@publicAddress.Url" Target="_blank" Typo="Typo.body2">@publicAddress.Display</MudLink>
                                        }
                                        else { <MudText Typo="Typo.body2">@publicAddress.Display</MudText> }
                                        <MudTooltip Text="复制映射地址"><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyPublicAddressAsync(publicAddress.Display))" /></MudTooltip>
                                        @if (publicAddress.Url is not null)
                                        {
                                            <MudTooltip Text="在新窗口打开"><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="@publicAddress.Url" Target="_blank" /></MudTooltip>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        }
                        <MudText Typo="Typo.caption">远端：@RemoteText(tunnel.RemoteState)</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <TunnelActionButtons Tunnel="tunnel" Loading="IsTunnelBusy(tunnel.Id)" Disabled="_batchBusy" Start="StartAsync" Stop="StopAsync" Kick="KickAsync" Edit="EditAsync" OpenLog="OpenLogAsync" Delete="DeleteAsync" />
                    </MudCardActions>
                </MudCard>
            }
        </MudStack>
    </MudHidden>
}
