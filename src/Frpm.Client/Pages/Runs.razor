@page "/runs"

<PageTitle>运行与日志 - FRPM</PageTitle>

<MudText Typo="Typo.h4" GutterBottom>运行与日志</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-5">每次启动生成独立运行记录，标准输出和错误输出均带时间与流标签。</MudText>

<MudGrid Class="runs-layout">
    <MudItem xs="12" md="4" Class="runs-list-column">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate />
        }
        else if (_runs.Count == 0)
        {
            <MudAlert Severity="Severity.Info">还没有运行记录。</MudAlert>
        }
        else
        {
            <MudList T="TunnelRunModel" Dense Class="runs-list">
                @foreach (var run in _runs)
                {
                    <MudListItem T="TunnelRunModel" Value="run" OnClick="() => SelectRunAsync(run)"
                                 Class="mb-1" Style="border:1px solid var(--mud-palette-lines-default);border-radius:8px">
                        <MudText Typo="Typo.body2">@run.TunnelName · @run.CliVersion</MudText>
                        <MudText Typo="Typo.caption">
                            @run.StartedAt.ToLocalTime().ToString("MM-dd HH:mm:ss") · @(run.EndedAt is null ? $"PID {run.ProcessId}" : $"退出码 {run.ExitCode}")
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </MudItem>
    <MudItem xs="12" md="8" Class="runs-log-column">
        <MudPaper Class="pa-4 runs-log-panel" Outlined Elevation="0">
            @if (_selected is null)
            {
                <MudText Color="Color.Secondary">选择一条运行记录查看日志。</MudText>
            }
            else
            {
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">@_selected.TunnelName</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshLogAsync" />
                </MudStack>
                <MudDivider Class="my-3" />
                <pre class="runs-log-output">@string.Join(Environment.NewLine, _lines)</pre>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
