@page "/Account/Lockout"

<PageTitle>账号已锁定</PageTitle>

<MudPaper Elevation="2" Class="pa-6 pa-sm-8 mx-auto" Style="max-width: 680px">
    <MudStack Spacing="3">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Error">账号已锁定</MudText>
            <MudText Typo="Typo.body1">请稍后再试。若无法确认管理员密码，请在运行 FRPM 的本机重置密码。</MudText>
        </div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            重置会生成一次性临时密码，并要求下次登录后立即修改。请在受信任的本机终端执行命令，勿将临时密码发送给他人或写入日志。
        </MudAlert>

        <MudText Typo="Typo.h6">Windows 安装版</MudText>
        <MudText Typo="Typo.body2">以管理员身份打开 PowerShell，依次执行：</MudText>
        <MudPaper Outlined="true" Class="pa-3"><code>Stop-Service FRPM<br />&amp; "$env:ProgramFiles\FRPM\server\Frpm.exe" --reset-admin-password<br />Start-Service FRPM</code></MudPaper>

        <MudText Typo="Typo.h6">Linux systemd 安装</MudText>
        <MudText Typo="Typo.body2">在解压后的 FRPM 目录中执行：</MudText>
        <MudPaper Outlined="true" Class="pa-3"><code>sudo systemctl stop frpm<br />./Frpm --reset-admin-password<br />sudo systemctl start frpm</code></MudPaper>

        <MudText Typo="Typo.h6">Docker Compose</MudText>
        <MudText Typo="Typo.body2">在包含 compose.yaml 的目录中执行：</MudText>
        <MudPaper Outlined="true" Class="pa-3"><code>docker compose stop frpm<br />docker compose run --rm frpm --reset-admin-password<br />docker compose start frpm</code></MudPaper>

        <MudText Typo="Typo.h6">免安装运行</MudText>
        <MudText Typo="Typo.body2">先停止 FRPM，再在程序所在目录执行：</MudText>
        <MudPaper Outlined="true" Class="pa-3"><code>./Frpm --reset-admin-password</code></MudPaper>

        <MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">返回登录</MudButton>
    </MudStack>
</MudPaper>
