@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Frpm.Data


<PageTitle>个人数据</PageTitle>

<StatusMessage />
<MudText Typo="Typo.h5" GutterBottom="true">个人数据</MudText>

<div class="row">
    <div class="col-md-6">
        <p>此账号包含您提供的个人数据。您可以在此下载或删除这些数据。</p>
        <p>
            <strong>删除这些数据将永久移除您的账号，且无法恢复。</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">下载</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">删除</a>
        </p>
    </div>
</div>
